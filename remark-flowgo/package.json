{
  "name": "remark-flowgo",
  "version": "0.1.0",
  "description": "remark plugin: render ```flowgo fenced code blocks inline in any remark/rehype pipeline (Next.js MDX, Astro, Docusaurus, Gatsby, 11ty) via a build-time placeholder + client-side hydration script.",
  "type": "module",
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lassediercks/flowgo.git",
    "directory": "remark-flowgo"
  },
  "homepage": "https://github.com/lassediercks/flowgo/tree/main/remark-flowgo#readme",
  "bugs": {
    "url": "https://github.com/lassediercks/flowgo/issues"
  },
  "keywords": [
    "remark",
    "remark-plugin",
    "unified",
    "mdast",
    "markdown",
    "mdx",
    "flowgo",
    "mind-map",
    "diagram"
  ],
  "engines": {
    "node": ">=18"
  },
  "files": [
    "dist",
    "vendor",
    "README.md"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./hydrate": {
      "types": "./dist/hydrate.d.ts",
      "import": "./dist/hydrate.js"
    },
    "./client": "./dist/flowgo-remark-client.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/build-client.mjs",
    "build:vendor": "node scripts/build-client.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "sanity": "node scripts/sanity-check.mjs",
    "prepublishOnly": "npm test"
  },
  "dependencies": {
    "unist-util-visit": "^5.0.0"
  },
  "devDependencies": {
    "@types/mdast": "^4.0.4",
    "@types/node": "^20.11.0",
    "@types/unist": "^3.0.3",
    "esbuild": "^0.21.5",
    "jsdom": "^24.1.0",
    "rehype-stringify": "^10.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.1",
    "typescript": "^5.4.0",
    "unified": "^11.0.5",
    "vitest": "^1.6.1"
  }
}
