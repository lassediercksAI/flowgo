.claude-container
.claude

# Compiled binary at repo root. Anchored with `/` so it doesn't also
# ignore pkg/flowgo (the library package directory).
/flowgo

# Local-only planning docs (not for public repo).
PLAN.md

# MemPalace per-project files (issue #185)
mempalace.yaml
entities.json

# Frontend toolchain (Vite-bundled editor + Vitest, pnpm)
# `dist/index.html` is the Go-embedded artifact and IS committed —
# fresh checkouts must build the binary without running pnpm first.
node_modules
.pnpm-store
*.tsbuildinfo

# Local dev artifacts created by `just dev`: the default map it opens
# and the media folder that pasted/dropped images are stored in.
# Anchored to the repo root so pkg/graph/map.flowgo stays tracked.
/map.flowgo
/flowgo-media/

# Local preset-authoring sandbox. The CANONICAL, shipped presets live
# in pkg/flowgo/presets/ (go:embed). Author here with `flowgo
# presets/<name>`, then copy the .flowgo into pkg/flowgo/presets/
# when it should ship in the binary.
/presets/

# `pnpm build:inline` output (see vite.inline.config.ts) — build it
# locally before opening demo/inline-demo.html.
/dist-inline/
